# Copy to .env to override. All optional; defaults are in src/config.js.
PORT=3000

# Where the SQLite file lives. Default: %LOCALAPPDATA%\smartattend\smartattend.db
# Kept outside the repo because OneDrive locks SQLite's WAL files.
# DB_PATH=./data/smartattend.db
# DB_PATH=:memory:

RFID_INTERVAL_MS=5000
FINGERPRINT_CHALLENGE_RATE=0.25
FINGERPRINT_SUCCESS_RATE=0.9
SIMULATION_ENABLED=true

# Gate devices (hardware/wokwi-gate) must send this as the X-Device-Key header.
# Leave empty to keep POST /api/rfid/scan open. Put the same value in the sketch.
# DEVICE_API_KEY=
# Oldest offline-queued gate scan the server accepts, and how far ahead a
# device clock may run before its scan time is refused.
OFFLINE_SCAN_MAX_AGE_DAYS=7
DEVICE_CLOCK_SKEW_MS=300000

# Outbound cloud sync (src/workers/syncWorker.js): API Gateway URL for the sync Lambda.
SYNC_API_GATEWAY_URL=http://localhost:4000/sync
SYNC_API_GATEWAY_KEY=placeholder
SYNC_POLL_INTERVAL_MS=30000
SYNC_BATCH_SIZE=50
SYNC_BACKOFF_MIN_MS=60000
SYNC_BACKOFF_MAX_MS=1800000
SYNC_MAX_ATTEMPTS=12
SYNC_REQUEST_TIMEOUT_MS=15000
SYNC_DEVICE_ID=tier2-server
# SYNC_WORKER_DISABLED=true

# The Lambdas in aws/ have their own config.
