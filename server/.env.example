# Copy to .env to override. All optional; defaults are in src/config.js.
PORT=3000

# Where the SQLite file lives. Default: %LOCALAPPDATA%\smartattend\smartattend.db
# Kept outside the repo because OneDrive locks SQLite's WAL files.
# DB_PATH=./data/smartattend.db
# DB_PATH=:memory:

RFID_INTERVAL_MS=5000
FINGERPRINT_CHALLENGE_RATE=0.25
FINGERPRINT_SUCCESS_RATE=0.9
SIMULATION_ENABLED=true

# Gate devices (hardware/wokwi-gate) must send this as the X-Device-Key header.
# Leave empty to keep POST /api/rfid/scan open. Put the same value in the sketch.
# DEVICE_API_KEY=
# Oldest offline-queued gate scan the server accepts, and how far ahead a
# device clock may run before its scan time is refused.
OFFLINE_SCAN_MAX_AGE_DAYS=7
DEVICE_CLOCK_SKEW_MS=300000

# School staff sign-in (src/auth/userAuth.js). Set a long random secret so
# sign-ins survive a restart, e.g. node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
# AUTH_TOKEN_SECRET=
# How long a staff sign-in lasts; long, so records queued offline can still be sent.
AUTH_TOKEN_TTL_DAYS=30

# "Continue with Google" for school admins and teachers (src/auth/googleAuth.js).
# Create an OAuth client (type: Web application) in Google Cloud Console >
# APIs & Services > Credentials, add the PWA's address (http://localhost:5173
# and the live one) under "Authorised JavaScript origins", and paste its id
# here. Only the server needs it; the PWA asks the server for it.
# Without it, a development-only stand-in asks for the Google email instead
# (off when NODE_ENV=production, or with GOOGLE_SIGNIN=off).
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Three months of made-up attendance for the Kibera demo school, filled in on
# every start (src/db/seedDemoData.js). Never sent to the cloud.
# DEMO_DATA=false

# Outgoing email (src/mail/mailer.js). Without these, emails are only printed
# to the console and listed at GET /api/dev/outbox, so the links still work
# while developing.
#   MAIL_TRANSPORT=ses
#   MAIL_FROM=SmartAttend <no-reply@yourdomain.com>   (a sender verified in SES)
#   AWS_REGION=eu-west-1
#   AWS_ACCESS_KEY_ID=...        an IAM user allowed ses:SendEmail
#   AWS_SECRET_ACCESS_KEY=...
# A new SES account is in the sandbox: it only sends to addresses you have
# verified in SES until AWS grants production access.
# MAIL_TRANSPORT=log
# Where the PWA is served, for the links in emails.
APP_URL=http://localhost:5173

# The one system admin account. Don't type these by hand: run
#   npm run sysadmin:set -- sysadmin
# which asks for the password and writes all three. Only a hash of the
# password is stored, and none of this is ever sent to the PWA.
# SYSTEM_ADMIN_USERNAME=
# SYSTEM_ADMIN_PASSWORD_HASH=
# SYSTEM_ADMIN_TOKEN_SECRET=
# How long a system admin sign-in lasts.
SYSTEM_ADMIN_TOKEN_TTL_HOURS=8

# Outbound cloud sync (src/workers/syncWorker.js): API Gateway URL for the sync Lambda.
# Leave unset until AWS is deployed: the worker stays off and records wait in
# sync_queue, then all go up once the URL is set.
# SYNC_API_GATEWAY_URL=https://<api-id>.execute-api.<region>.amazonaws.com/prod/sync
# SYNC_API_GATEWAY_KEY=
SYNC_POLL_INTERVAL_MS=30000
SYNC_BATCH_SIZE=50
SYNC_BACKOFF_MIN_MS=60000
SYNC_BACKOFF_MAX_MS=1800000
SYNC_MAX_ATTEMPTS=12
SYNC_REQUEST_TIMEOUT_MS=15000
SYNC_DEVICE_ID=tier2-server
# SYNC_WORKER_DISABLED=true

# The Lambdas in aws/ have their own config.
